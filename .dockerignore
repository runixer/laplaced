# Never copy runtime secrets or local state into the Go builder layer. Compose
# still reads .env on the host and injects it into the final container at run
# time; it does not need to be part of the image build context.
.env
.env.*
!.env.example
configs/
data/
logs/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
*.pem
*.key

# Repository/developer metadata is not needed to compile cmd/bot.
.git/
.gitea/
.github/
.agents/
.codex/
.claude/
.idea/
.vscode/
docs/
bin/
coverage.*
*.coverprofile
*.out
*.test
laplaced
bot
testbot
